generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String   @map("password")
  name          String
  role          Role     @default(PHC_STAFF)
  phcId         String?
  phc           PHC?     @relation(fields: [phcId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  FIELD_WORKER
  PHC_STAFF
  GOVERNMENT_OFFICIAL
  
  // Legacy roles kept for backward compatibility if needed by other parts of the app
  SUPER_ADMIN
  NATIONAL_ADMIN
  STATE_ADMIN
  DISTRICT_ADMIN
  SUPPLY_OFFICER
  EMERGENCY_OFFICER
}

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  districts District[]
}

model District {
  id      String @id @default(uuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  phcs    PHC[]

  @@unique([name, stateId])
}

model PHC {
  id             String             @id @default(uuid())
  code           String?            @unique
  name           String
  state          String?
  districtId     String
  district_name  String?
  city           String?
  districtRel    District           @relation(fields: [districtId], references: [id])
  latitude       Float
  longitude      Float
  population     Int
  users          User[]
  inventories    Inventory[]
  bedCapacity    BedCapacity?
  staff          Staff?
  forecasts      Forecast[]
  riskScores     RiskScore[]
  alerts         Alert[]
  sourceTransfers ResourceTransfer[] @relation("SourceTransfers")
  destTransfers   ResourceTransfer[] @relation("DestTransfers")
  patientVisits  PatientVisit[]
  
  healthReports      HealthReport[]
  diseaseReports     DiseaseReport[]
  vaccinationRecords VaccinationRecord[]
  mlPredictions      MLPrediction[]
  
  createdAt DateTime @default(now())
}

model Medicine {
  id             String             @id @default(uuid())
  name           String             @unique
  category       String
  unit           String
  inventories    Inventory[]
  forecasts      Forecast[]
  transfers      ResourceTransfer[]
  mlPredictions  MLPrediction[]
}

model Inventory {
  id               String   @id @default(uuid())
  facility_id      String   @map("phcId")
  phc              PHC      @relation(fields: [facility_id], references: [id])
  medicineId       String
  medicine         Medicine @relation(fields: [medicineId], references: [id])
  date             DateTime @default(now())
  opening_stock    Int      @default(0)
  received_quantity Int     @default(0)
  dispensed_quantity Int    @default(0)
  closing_stock    Int      @default(0)
  currentStock     Int
  dailyConsumption Float
  reorderLevel     Int
  updatedAt        DateTime @updatedAt

  @@unique([facility_id, medicineId])
  @@index([facility_id])
  @@index([date])
}

model BedCapacity {
  id           String @id @default(uuid())
  phcId        String @unique
  phc          PHC    @relation(fields: [phcId], references: [id])
  totalBeds    Int
  occupiedBeds Int
  icuBeds      Int
  occupiedIcu  Int
  updatedAt    DateTime @updatedAt
}

model Staff {
  id               String @id @default(uuid())
  phcId            String @unique
  phc              PHC    @relation(fields: [phcId], references: [id])
  totalDoctors     Int
  availableDoctors Int
  totalNurses      Int
  availableNurses  Int
  updatedAt        DateTime @updatedAt
}

model Forecast {
  id              String   @id @default(uuid())
  phcId           String
  phc             PHC      @relation(fields: [phcId], references: [id])
  medicineId      String
  medicine        Medicine @relation(fields: [medicineId], references: [id])
  predictedDemand Int
  periodHours     Int
  confidence      Float
  createdAt       DateTime @default(now())
}

model RiskScore {
  id        String   @id @default(uuid())
  phcId     String
  phc       PHC      @relation(fields: [phcId], references: [id])
  score     Float
  category  String
  createdAt DateTime @default(now())
}

model Alert {
  id          String   @id @default(uuid())
  facility_id String   @map("phcId")
  phc         PHC      @relation(fields: [facility_id], references: [id])
  title       String?
  alert_type  String?
  severity    String // CRITICAL, HIGH, WARNING, INFO, WATCH
  message     String?
  reason      String?
  resolved    Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, RESOLVED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  
  @@index([facility_id])
}

model ResourceTransfer {
  id             String   @id @default(uuid())
  sourcePHCId    String
  sourcePHC      PHC      @relation("SourceTransfers", fields: [sourcePHCId], references: [id])
  destPHCId      String
  destPHC        PHC      @relation("DestTransfers", fields: [destPHCId], references: [id])
  medicineId     String
  medicine       Medicine @relation(fields: [medicineId], references: [id])
  quantity       Int
  distanceKm     Float
  estimatedHours Float
  status         String   @default("PENDING") // PENDING, APPROVED, IN_TRANSIT, COMPLETED
  createdAt      DateTime @default(now())
}

model PatientVisit {
  id        String   @id @default(uuid())
  phcId     String
  phc       PHC      @relation(fields: [phcId], references: [id])
  date      DateTime
  count     Int
  disease   String?
}

// --------------------------------------------------
// NEW MODELS REQUESTED BY USER
// --------------------------------------------------

model HealthReport {
  id                   String   @id @default(uuid())
  facility_id          String
  phc                  PHC      @relation(fields: [facility_id], references: [id])
  report_date          DateTime @default(now())
  patient_count        Int      @default(0)
  disease_cases        Int      @default(0)
  mortality            Int      @default(0)
  bed_occupancy        Float    @default(0.0)
  vaccination_coverage Float    @default(0.0)
  
  @@index([facility_id])
  @@index([report_date])
}

model DiseaseReport {
  id               String   @id @default(uuid())
  facility_id      String
  phc              PHC      @relation(fields: [facility_id], references: [id])
  disease          String
  suspected_cases  Int      @default(0)
  confirmed_cases  Int      @default(0)
  mortality        Int      @default(0)
  report_date      DateTime @default(now())
  
  @@index([facility_id])
  @@index([report_date])
}

model VaccinationRecord {
  id                  String   @id @default(uuid())
  facility_id         String
  phc                 PHC      @relation(fields: [facility_id], references: [id])
  vaccine             String
  doses_administered  Int      @default(0)
  target_population   Int      @default(0)
  coverage            Float    @default(0.0)
  date                DateTime @default(now())
  
  @@index([facility_id])
  @@index([date])
}

model MLPrediction {
  id                       String   @id @default(uuid())
  facility_id              String
  phc                      PHC      @relation(fields: [facility_id], references: [id])
  medicine_id              String
  medicine                 Medicine @relation(fields: [medicine_id], references: [id])
  predicted_7_day_demand   Float
  stockout_probability     Float
  risk_level               String   // LOW, MEDIUM, HIGH, CRITICAL
  estimated_days_of_stock  Float
  predicted_shortage_units Int
  model_version            String   @default("v1.0")
  created_at               DateTime @default(now())
  
  @@index([facility_id])
  @@index([risk_level])
  @@index([created_at])
}
